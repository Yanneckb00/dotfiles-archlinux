[arcmenu]
force-menu-location='MonitorCentered'
menu-button-appearance='Icon'
menu-layout='Pop'
override-menu-theme=false
pop-folders-data={'Library Home': 'Eigene Bibliothek', 'System': 'System', 'Utilities': 'Dienstprogramme'}
prefs-visible-page=0
recently-installed-apps=['org.openrgb.OpenRGB.desktop', 'org.rncbc.qjackctl.desktop', 'SuperColliderIDE.desktop', 'com.jeffser.Alpaca.desktop', 'winetricks.desktop', 'org.gnome.Yelp.desktop', 'org.kde.showfoto.desktop', 'com.lunarclient.LunarClient.desktop', 'terminator.desktop', 'xterm.desktop', 'uxterm.desktop', 'termius.desktop', 'org.mozilla.thunderbird_esr.desktop', 'wine-Programs-Ableton Live 12 Suite.desktop']
search-entry-border-radius=(true, 25)
update-notifier-project-version=73

[blur-my-shell]
rounded-blur-found=false
settings-version=2

[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/applications]
blur=true
brightness=1.0
dynamic-opacity=false
opacity=185
sigma=30
whitelist=['kitty']

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
pipeline='pipeline_default_rounded'
sigma=30
static-blur=true
style-dash-to-dock=0

[blur-my-shell/hidetopbar]
compatibility=false

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'

[blur-my-shell/panel]
